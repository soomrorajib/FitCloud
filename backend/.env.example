# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed by CORS. Comma separate for more than one.
# Local:       http://localhost:5173
# Production:  https://your-frontend.vercel.app   (must match exactly, no trailing slash)
CLIENT_URL=http://localhost:5173

# ---------- MongoDB Atlas ----------
MONGODB_URI=

# ---------- JWT ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- AWS S3 (profile pictures) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ---------- Optional ----------
# Use a CloudFront / custom domain for image URLs (leave empty to use the normal S3 URL)
AWS_S3_PUBLIC_URL=
# Only for local testing with LocalStack / MinIO. Leave EMPTY on AWS.
AWS_S3_ENDPOINT=
# Rate limits (requests per window)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CONTACT_RATE_LIMIT_MAX=10
